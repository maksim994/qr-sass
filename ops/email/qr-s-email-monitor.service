[Unit]
Description=QR-S independent email and backup monitor
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/qr-s-backup/email-monitor.py
User=root
UMask=0077
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
