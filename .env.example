# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qr_saas?schema=public
POSTGRES_PASSWORD=
# Production: 32+ random characters. The app refuses to start without it.
JWT_SECRET=
APP_URL=https://qr-s.ru

# S3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_PUBLIC_OMIT_BUCKET=true
S3_PREFIX=qr

# New checkout provider. Keep YooKassa keys for old orders and notifications.
BILLING_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Robokassa: algorithm must match merchant technical settings.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_HASH_ALGORITHM=SHA256
ROBOKASSA_TEST_MODE=true
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
# Live passwords must differ from test passwords. Keep empty until live setup.
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=

# Beget SMTP for service notifications; set on app and email-worker at runtime.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QR-S.ru <noreply@qr-s.ru>

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
# docker-compose.yml передаёт TRUST_PROXY=1 в контейнер приложения по умолчанию.
TRUST_PROXY=
# Optional HMAC secret for analytics IP hashes. Falls back to JWT_SECRET.
ANALYTICS_HASH_SECRET=
# Drop raw User-Agent and IP hashes older than N days. Default 90.
ANALYTICS_RETENTION_DAYS=90

# Base64 32-byte key for encrypted admin integration tokens. Back up; do not rotate without re-encrypting.
# Required for the encrypted email queue (32 random bytes, base64).
ADMIN_INTEGRATIONS_KEY=

# Optional one-time rotation: retain old 7-day login sessions; never sign new tokens with this key.
# Set both only at deployment, then remove both after seven days. Never commit real keys.
JWT_PREVIOUS_SECRET=
JWT_ROTATED_AT=

# Optional server-only OAuth token for offline payment conversions. Never NEXT_PUBLIC.
# With an empty token the Metrika worker remains inactive.
METRIKA_OAUTH_TOKEN=

# Яндекс ID: приложение для авторизации, callback должен совпадать с APP_URL.
# При отсутствии ключей или YANDEX_AUTH_ENABLED=false кнопки Яндекса скрыты.
YANDEX_AUTH_ENABLED=true
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://qr-s.ru/api/auth/yandex/callback

# Abuse protection: secrets only in production env; Google Web Risk is opt-in.
YANDEX_SAFE_BROWSING_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
GOOGLE_WEB_RISK_ENABLED=false
ABUSE_CHECK_ENABLED=true
ABUSE_CHECK_TIMEOUT_MS=3000
ABUSE_REPORTS_THRESHOLD=3
ABUSE_RECHECK_HOUR=4
ABUSE_RECHECK_BATCH_DELAY_MS=1000
ABUSE_SB_DAILY_QUOTA=9000
ABUSE_AUDIT_IP_RETENTION_DAYS=365
ABUSE_REQUIRE_VERIFIED_EMAIL=false
ABUSE_NEW_ACCOUNT_HOURS=24
QR_CREATE_PER_HOUR=30
QR_CREATE_PER_IP_PER_HOUR=60
QR_URL_CHANGE_PER_HOUR=10
QR_URL_CHANGE_USER_PER_HOUR=60
ABUSE_REPORTS_PER_IP_PER_HOUR=5
REGISTER_PER_IP_PER_DAY=10
