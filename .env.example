# Required
POSTGRES_PASSWORD=
# Production: 32+ random characters. The app refuses to start without it.
JWT_SECRET=
APP_URL=https://qr-s.ru

# S3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_PUBLIC_OMIT_BUCKET=true
S3_PREFIX=qr

# YooKassa (для приёма оплаты)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# YooKassa (для оплаты на сайте)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=

# Optional SMTP for password reset. Without it the form still works; the link is not emailed.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QR-S.ru <noreply@qr-s.ru>

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
# docker-compose.yml передаёт TRUST_PROXY=1 в контейнер приложения по умолчанию.
TRUST_PROXY=
# Optional HMAC secret for analytics IP hashes. Falls back to JWT_SECRET.
ANALYTICS_HASH_SECRET=
# Drop raw User-Agent and IP hashes older than N days. Default 90.
ANALYTICS_RETENTION_DAYS=90

# Base64 32-byte key for encrypted admin integration tokens. Back up; do not rotate without re-encrypting.
ADMIN_INTEGRATIONS_KEY=

# Optional one-time rotation: retain old 7-day login sessions; never sign new tokens with this key.
# Set both only at deployment, then remove both after seven days. Never commit real keys.
JWT_PREVIOUS_SECRET=
JWT_ROTATED_AT=
