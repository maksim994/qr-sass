  "narrative": {
    "northStar": "One QR-S public site",
    "overview": "The existing homepage is the visual authority. Its broad inset grid, Manrope typography, blue actions and white/slate surfaces carry through pricing, marketing pages, generators, blog, legal documents and authentication. This is a refinement of the established identity, rather than a new brand direction.\n\nPublic screens feel open and practical. Borders and muted surfaces organize information; existing QR and print illustrations explain the product. Reading columns and forms keep their own comfortable measure inside the shared outer grid. Dashboard, administration and user-authored hosted QR designs are outside this document's scope.",
    "keyCharacteristics": [
      "A single outer grid with responsive side insets.",
      "Manrope throughout, with compact labels and strong balanced headings.",
      "Blue actions and selection states over semantic white/slate surfaces.",
      "Flat interface panels with restrained borders and visible keyboard focus.",
      "Existing product illustrations, readable documents and task-focused forms."
    ],
    "rules": [
      {
        "name": "The One Action Family Rule",
        "body": "Public primary and accent actions use the established blue family; reserve status colors for their actual meaning.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Keep public headings, controls and prose in Manrope; introduce hierarchy through size, weight, measure and spacing.",
        "section": "typography"
      },
      {
        "name": "The One Outer Grid Rule",
        "body": "Derive public width and side insets from the shared public properties. Do not add a second container max-width or horizontal padding that narrows an entire public page.",
        "section": "layout"
      },
      {
        "name": "The Flat Interface Rule",
        "body": "Use tonal layering and restrained borders for public interface panels; keep physical depth within the existing product artwork.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do align public headers, titles and broad content to the shared outer grid.",
      "Do keep readable inner measures for prose and forms within that grid.",
      "Do use semantic colors so light and dark themes retain the same hierarchy.",
      "Do preserve visible focus, native disclosure behavior and reduced-motion support.",
      "Do keep embedded titles and QR details in article artwork visible at mobile sizes."
    ],
    "donts": [
      "Don't add a second page-wide max-width or double horizontal padding inside the public container.",
      "Don't introduce a separate font, action palette or legacy header treatment for an individual public route.",
      "Don't transfer physical illustration shadows and rotations to ordinary interface cards.",
      "Don't crop meaningful text or QR details merely to fill an image frame.",
      "Don't extend these public-only rules into dashboard, administration or customer-authored QR layouts without reviewing those surfaces."
    ]
  }
}
