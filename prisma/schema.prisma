generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum QrKind {
  STATIC
  DYNAMIC
}

enum QrContentType {
  URL
  TEXT
  EMAIL
  PHONE
  SMS
  WIFI
  VCARD
  LOCATION
  PDF
  IMAGE
  VIDEO
  MP3
  MENU
  BUSINESS
  LINK_LIST
  COUPON
  APP_STORE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  SOCIAL_LINKS
}

model User {
  emailVerificationTokens EmailVerificationToken[]
  metrikaRegistrationPending Boolean @default(false)
  id           String       @id @default(cuid())
  email        String       @unique
  yandexId     String?      @unique
  avatarUrl    String?
  passwordHash String
  name         String?
  isAdmin      Boolean      @default(false)
  sessionVersion Int        @default(0)
  emailVerifiedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  qrCodes      QrCode[]     @relation("CreatedByQrCodes")
  blogPosts    BlogPost[]   @relation("CreatedBlogPosts")
  passwordResets PasswordResetToken[]
  legalAcceptances LegalAcceptance[]
  sentInvites WorkspaceInvite[] @relation("WorkspaceInvitesSent")
  authIdentities AuthIdentity[]
}

// Provider-owned subject, never inferred from a user-editable email address.
model AuthIdentity {
  id        String   @id @default(cuid())
  provider  String
  subject   String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]

  @@index([sortOrder])
}

model BlogPost {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  metaTitle         String?        // SEO title (если не задан — используется title)
  metaDescription   String?        // SEO description (если не задан — используется excerpt)
  excerpt           String?
  content           String         @db.Text
  format            String         @default("html") // html | markdown; existing content is never converted by migration
  renderedHtml      String?        @db.Text // sanitized Markdown render at save; sanitized again on read
  legacyHtml        String?        @db.Text // exact original HTML saved on explicit conversion
  faq               Json           @default("[]")
  showPrintSizeIntro Boolean       @default(true)
  tags              String[]       @default([])
  relatedArticleIds String[]       @default([])
  contentUpdatedAt  DateTime?      // null on legacy rows: use updatedAt until first editorial save
  firstPublishedAt  DateTime?      // preserves original publication across unpublish/republish
  coverImageUrl     String?
  coverImageAlt     String?
  authorName        String?        // отображаемое имя автора
  structuredData    String?        @db.Text // JSON-LD микроразметка (если не задана — генерируется автоматически)
  views             Int            @default(0)
  likes             Int            @default(0)
  readingTimeMinutes Int?          // вручную или авто: словоcount / 200
  status            BlogStatus? // null: legacy publication inferred from publishedAt
  scheduledAt       DateTime?
  previewTokens     BlogPreviewToken[]
  pendingRevision   BlogPendingRevision?
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?
  categoryId        String?
  createdBy         User?          @relation("CreatedBlogPosts", fields: [createdById], references: [id], onDelete: SetNull)
  category          BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([publishedAt])
  @@index([slug])
  @@index([categoryId])
}

enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
}

model QrBulkBatch {
  id String @id @default(cuid())
  workspaceId String
  key String
  digest String
  records Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model Workspace {
  partnerId String?
  partnerIsTest Boolean @default(false)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  @@index([partnerId, partnerIsTest])
  bulkBatches QrBulkBatch[]
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  plan          WorkspacePlan  @default(FREE)
  accessMode    String         @default("standard") // standard, archive, friends (admin-only)
  archivedPlan  Json?          // immutable release snapshot; never supplied by a client
  trialUsedAt   DateTime?      // Триал PRO уже использован
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  apiKeys       ApiKey[]
  memberships   Membership[]
  projects      Project[]
  qrCodes       QrCode[]
  uploadedFiles UploadedFile[]
  subscription  Subscription?
  payments      Payment[]
  billingEvents BillingEvent[]
  funnelEvents  FunnelEvent[]
  invites WorkspaceInvite[]
}

model Membership {
  id          String         @id @default(cuid())
  role        MembershipRole @default(MEMBER)
  userId      String
  workspaceId String
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id              String                @id @default(cuid())
  workspaceId     String
  email           String
  invitedByUserId String
  status          WorkspaceInviteStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  respondedAt     DateTime?
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User                  @relation("WorkspaceInvitesSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  qrCodes     QrCode[]
}

model UploadedFile {
  id          String    @id @default(cuid())
  workspaceId String
  key         String    @unique
  filename    String
  mimeType    String
  sizeBytes   Int
  url         String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model QrCode {
  id               String        @id @default(cuid())
  workspaceId      String
  projectId        String?
  createdById      String
  kind             QrKind
  contentType      QrContentType
  name             String
  shortCode        String?       @unique
  encodedContent   String
  currentTargetUrl String?
  payload          Json?
  styleConfig      Json?
  expireAt         DateTime?
  maxScans         Int?
  passwordHash     String?
  isArchived       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy        User          @relation("CreatedByQrCodes", fields: [createdById], references: [id], onDelete: Restrict)
  revisions        QrRevision[]
  scanEvents       ScanEvent[]
  funnelEvents     FunnelEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, contentType])
}

model QrRevision {
  id             String   @id @default(cuid())
  qrCodeId       String
  destinationUrl String?
  encodedContent String
  changedById    String
  createdAt      DateTime @default(now())
  qrCode         QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyPrefix   String    // first 8 chars for display
  keyHash     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([keyPrefix])
}

model PlanOverride {
  id            String       @id @default(cuid())
  planId       WorkspacePlan @unique
  maxQrCodes   Int?
  maxUsers     Int?
  priceRub     Int?          // Цена за месяц в рублях (null = из дефолтов)
  allowsDynamic Boolean?
  allowsAnalytics Boolean?
  exportFormats String?       // JSON array: ["PNG","SVG"]
  updatedAt    DateTime     @default(now())
}

model ScanEvent {
  id           String   @id @default(cuid())
  qrCodeId     String
  scannedAt    DateTime @default(now()) @db.Timestamptz(3)
  country      String?
  city         String?
  deviceType   String?
  os           String?
  browser      String?
  referer      String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  ipHash       String?
  userAgentRaw String?
  abVariant    String?  // "A" | "B" for A/B tests
  qrCode       QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, scannedAt])
}

model SiteSettings {
  id                String   @id @default("default")
  yandexMetrikaId   String?
  customHeadCode    String?  @db.Text
  robotsTxtContent  String?  @db.Text
  faviconUrl        String?
  indexNowKey       String?  // IndexNow: 8–128 символов, a-z A-Z 0-9 -
  analyticsPurgedAt DateTime?
  analyticsPurgeUpdated Int @default(0)
  contactEmail      String?
  contactPhone      String?
  requisitesInn     String?
  requisitesName    String?
  disabledQrTypes   String?  @db.Text // JSON array: ["TEXT","EMAIL"]
  updatedAt         DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  REFUNDED
}

model Subscription {
  id              String        @id @default(cuid())
  workspaceId     String        @unique
  plan            WorkspacePlan
  status          String        @default("active") // active, past_due, canceled
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean     @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments        Payment[]
}

model Payment {
  metrikaUserId String?
  metrikaClientId String?
  metrikaCounterId String?
  metrikaConsentAt DateTime?
  metrikaConsentVersion String?
  metrikaState String @default("PENDING") // PENDING, SENDING, UPLOADED, PROCESSED, REVIEW, EXPIRED, REVOKED
  metrikaUploadId String?
  metrikaAttemptAt DateTime?
  metrikaLastError String?
  id              String        @id @default(cuid())
  workspaceId     String
  subscriptionId  String?
  paidAt          DateTime?
  provider        String        @default("yookassa")
  providerPaymentId String      @unique // YooKassa ID or robokassa:<InvId>
  amount          Int           // в рублях
  currency        String        @default("RUB")
  planId          WorkspacePlan?
  termsMode       String?       // archive/current: choice made when checkout was created
  isTest          Boolean       @default(false)
  status          PaymentStatus @default(PENDING)
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingEvents   BillingEvent[]

  @@index([workspaceId])
}

model BillingEvent {
  id                 String    @id @default(cuid())
  workspaceId        String?
  paymentId          String?
  providerPaymentId  String?
  type               String
  message            String?
  payload            Json?
  createdAt          DateTime  @default(now())
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  payment            Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([providerPaymentId])
  @@index([type, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FunnelEvent {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  qrCodeId    String?
  paymentId   String?
  name        String
  source      String?
  isTest      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  qrCode      QrCode?   @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, name, createdAt])
  @@index([qrCodeId, name, createdAt])
  @@index([paymentId, name])
  @@index([isTest, name, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  action      String
  entityId    String
  reason      String
  before      Json
  after       Json
  createdAt   DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([createdAt])
}

model BusinessEvent {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  workspaceId String?
  userId      String?
  paymentId   String?
  isTest      Boolean  @default(false)
  payload     Json
  createdAt   DateTime @default(now())
  @@index([name, isTest, createdAt])
  @@index([workspaceId, createdAt])
}

model TelegramSettings {
  id          String   @id @default("default")
  enabled     Boolean  @default(false)
  tokenCipher String?
  chatId      String   @default("")
  events      String[] @default(["registration_completed", "trial_started", "payment_succeeded"])
  dailyDigest Boolean  @default(true)
  digestHour  Int      @default(9)
  revision    Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model NotificationOutbox {
  id            String   @id @default(cuid())
  key           String   @unique
  eventName     String
  text          String
  chatId        String
  revision      Int
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  leaseToken    String?
  lastError     String?
  messageId     String?
  createdAt     DateTime @default(now())
  sentAt        DateTime?
  @@index([status, nextAttemptAt])
}

model NotificationWorkerState {
  id          String   @id @default("default")
  lastSeenAt  DateTime @default(now())
}

// Separate evidence for terms and data consent, captured in the registration transaction.
model LegalAcceptance {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version String
  source String
  acceptedAt DateTime @default(now())
  termsAccepted Boolean
  dataConsent Boolean
  documents Json
  @@index([userId, acceptedAt])
}

// Short-lived, one-use OAuth state, created only by a CSRF-protected explicit POST.
model OAuthLegalIntent {
  stateHash String @id
  version String
  acceptedAt DateTime @default(now())
  expiresAt DateTime
  documents Json
  @@index([expiresAt])
}

model Partner {
  id String @id @default(cuid())
  code String @unique
  name String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  visits PartnerVisit[]
  workspaces Workspace[]
}

model PartnerVisit {
  id String @id @default(uuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime
  clicks Int @default(1)
  isTest Boolean @default(false)
  consentVersion String
  @@index([partnerId, isTest])
}


enum BlogStatus {
  draft
  scheduled
  published
}

// Snapshots deliberately survive article/user deletion; actor and title are historical facts.
model BlogRevision {
  id String @id @default(cuid())
  postId String
  number Int
  snapshot Json
  actorId String?
  actorName String
  source String
  comment String?
  createdAt DateTime @default(now())
  @@unique([postId, number])
  @@index([postId, createdAt])
}

model BlogEvent {
  id String @id @default(cuid())
  postId String
  postTitle String
  actorId String?
  actorName String
  source String
  type String
  fields String[]
  comment String?
  revisionId String?
  createdAt DateTime @default(now())
  @@index([postId, createdAt])
  @@index([actorName, createdAt])
  @@index([type, createdAt])
}

model BlogPreviewToken {
  hash String @id
  postId String
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  pendingRevisionId String?
  pendingRevision BlogPendingRevision? @relation(fields: [pendingRevisionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([postId, revokedAt])
  @@index([pendingRevisionId])
}

// Global editorial API; deliberately separate from workspace QR keys.
model BlogApiToken {
  id String @id @default(cuid())
  name String
  keyPrefix String @unique
  keyHash String
  salt String
  createdById String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  windowStartedAt DateTime?
  requestCount Int @default(0)
}

model BlogRedirect {
  id String @id @default(cuid())
  source String @unique
  target String
  comment String?
  actorName String
  createdAt DateTime @default(now())
}

model BlogImage {
  id String @id
  url String @unique
  kind String
  alt String
  width Int
  height Int
  variants Json
  actorName String
  createdAt DateTime @default(now())
}

// One unpublished editorial patch per live article; never returned by public post queries.
model BlogPendingRevision {
  id String @id @default(cuid())
  postId String @unique
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  input Json
  snapshot Json
  baseUpdatedAt DateTime
  actorName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  previewTokens BlogPreviewToken[]
}

model EmailControl {
  id String @id @default("default")
  enabledSince DateTime @default(now())
  lastSeenAt DateTime?
  lastScheduledAt DateTime?
}
model EmailOutbox {
  id String @id @default(cuid())
  key String @unique
  kind String
  toEmail String
  userId String?
  workspaceId String?
  context Json @default("{}")
  payloadCipher String?
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  expiresAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  errorCode String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([status, nextAttemptAt])
  @@index([userId, kind, createdAt])
}
model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  email String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
